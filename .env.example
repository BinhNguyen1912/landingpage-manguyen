# Biến môi trường — Supabase
# Sao chép file này thành .env và điền giá trị thực
# ⚠Ỹ KHÔNG BAO GIờ commit file .env lên Git!

# Supabase Project URL (lấy từ Supabase Dashboard → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Publishable / Anon Key (lấy từ Supabase Dashboard → Settings → API)
# Có thể là "anon key" (dự án cũ) hoặc "publishable key" (dự án mới)
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx

# ⚠Ỹ Khi deploy lên Vercel: thêm 2 biến này vào:
# Vercel Dashboard → Project → Settings → Environment Variables
