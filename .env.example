# Biến môi trường — Supabase
# Sao chép file này thành .env và điền giá trị thực

# Supabase Project URL (lấy từ Supabase Dashboard → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Anon/Public Key (lấy từ Supabase Dashboard → Settings → API)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ KHÔNG BAO GIỜ commit file .env lên Git
# ⚠️ KHÔNG dùng service_role key trong frontend code
